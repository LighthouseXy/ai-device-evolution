{
  "name": "device-scope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:data": "node scripts/build-device-database.mjs",
    "predev": "npm run build:data",
    "dev": "WATCHPACK_POLLING=true next dev --webpack",
    "prebuild": "npm run build:data",
    "build": "next build",
    "start": "next start",
    "sync:apple-zh-cn": "node scripts/sync-apple-zh-cn-data.mjs",
    "sync:xiaomi-pilot": "node scripts/sync-xiaomi-ultra-pilot.mjs",
    "sync:oppo-find-x-ultra": "node scripts/sync-oppo-find-x-ultra.mjs",
    "sync:vivo-x-ultra": "node scripts/sync-vivo-x-ultra.mjs",
    "prices": "node scripts/price-snapshot-workflow.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "precheck": "npm run build:data",
    "check": "npm run typecheck && npm run lint && npm run test:device-taxonomy && npm run test:device-data-quality && npm run test:price-workflow && npm run test:compare-configuration && npm run test:ai-analysis && npm run test:device-advisor && npm run test:device-advisor-api",
    "lint": "eslint",
    "test:ai-analysis": "node scripts/ai-analysis-regression.mjs",
    "test:device-taxonomy": "node scripts/validate-device-taxonomy.mjs",
    "test:device-data-quality": "node scripts/audit-device-data-quality.mjs",
    "test:price-workflow": "node scripts/price-snapshot-workflow-regression.mjs",
    "test:compare-configuration": "node scripts/compare-configuration-regression.mjs",
    "test:device-advisor": "node scripts/device-advisor-regression.mjs",
    "test:device-advisor-api": "node scripts/device-advisor-api-regression.mjs",
    "eval:device-advisor": "node scripts/device-advisor-ai-eval.mjs",
    "eval:ai-analysis": "node scripts/ai-analysis-eval.mjs"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
